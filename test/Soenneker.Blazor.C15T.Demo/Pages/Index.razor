@page "/"
@using System.Threading.Tasks
@using Soenneker.Blazor.C15T.Abstract

@inject IC15t C15T

<PageTitle>Soenneker.Blazor.C15T Demo</PageTitle>

<Div Space="Space.Y.Is4">
    <Paragraph TextSize="TextSize.Sm" Class="text-muted-foreground">
        Replace this page with package-specific demos. Initialization runs on first render below.
    </Paragraph>
</Div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await C15T.Initialize();
    }
}
